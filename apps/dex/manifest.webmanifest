{
  "name": "Gridiron Dex",
  "short_name": "Gridiron Dex",
  "description": "Pokédex-style pixel-art browser for Madden 27 ratings",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12141c",
